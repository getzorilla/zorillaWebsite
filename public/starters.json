  {
    "slug": "eth-price-watch",
    "title": "eth price watch",
    "summary": "Runs with no keys at all. Reads a public price feed and stays quiet until the price crosses a line.",
    "package": {
      "name": "eth price watch",
      "nodes": [
        {
          "id": "clock",
          "type": "core.schedule",
          "params": {
            "mode": "every",
            "every": 15,
            "unit": "minutes"
          },
          "position": {
            "x": 60,
            "y": 200
          }
        },
        {
          "id": "price",
          "type": "coingecko.price",
          "params": {
            "ids": "ethereum",
            "currency": "usd"
          },
          "position": {
            "x": 320,
            "y": 200
          }
        },
        {
          "id": "cross",
          "type": "logic.changed",
          "params": {
            "value": "{{ $json.ethereum.usd > 4000 }}",
            "direction": "becomesTrue",
            "key": ""
          },
          "position": {
            "x": 580,
            "y": 200
          }
        },
        {
          "id": "say",
          "type": "output.log",
          "params": {
            "message": "ETH is {{ $json.ethereum.usd }} — swap this step for an email or a text"
          },
          "position": {
            "x": 840,
            "y": 200
          }
        }
      ],
      "edges": [
        {
          "from": "clock",
          "fromPort": "main",
          "to": "price",
          "toPort": "main"
        },
        {
          "from": "price",
          "fromPort": "main",
          "to": "cross",
          "toPort": "main"
        },
        {
          "from": "cross",
          "fromPort": "main",
          "to": "say",
          "toPort": "main"
        }
      ]
    }
  },
