      "nodes": [
        {
          "id": "clock",
          "type": "core.schedule",
          "params": {
            "mode": "every",
            "every": 1,
            "unit": "days"
          },
          "position": {
            "x": 40,
            "y": 170
          }
        },
        {
          "id": "read",
          "type": "web3.read",
          "params": {
            "chain": "ethereum",
            "address": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
            "signature": "function totalSupply() view returns (uint256)",
            "args": [],
            "rpc": ""
          },
          "position": {
            "x": 300,
            "y": 170
