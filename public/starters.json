[
  {
    "slug": "chain-news-to-x",
    "title": "chain news to x",
    "summary": "Checks a news feed every 30 minutes, keeps anything about Robinhood's chain, has Claude draft a post about it, and puts it on X. Needs a Claude key named my_claude and an X key named my_x with write permission, plus a news feed you can read as JSON.",
    "package": {
      "name": "chain news to x",
      "nodes": [
        {
          "id": "clock",
          "type": "core.schedule",
          "params": {
            "mode": "every",
            "every": 30,
            "unit": "minutes"
          },
          "position": {
            "x": 40,
            "y": 110
          }
        },
        {
          "id": "news",
          "type": "net.http",
          "params": {
            "method": "GET",
            "url": "https://api.cryptopanic.com/v1/posts/",
            "credential": "",
            "headers": [],
            "sendBody": false,
            "timeout": 30,
            "failOnError": true
          },
          "position": {
            "x": 290,
            "y": 110
          }
        },
        {
          "id": "each",
          "type": "code.js",
          "params": {
            "code": "return items.flatMap(i => (i.json.body.results ?? []).map(post => ({ json: post })))",
            "credential": "",
            "timeout": 15
          },
          "position": {
            "x": 540,
            "y": 110
          }
        },
        {
          "id": "about",
          "type": "logic.filter",
          "params": {
            "value": "{{ $json.title }}",
            "operation": "contains",
            "compare": "Robinhood"
          },
          "position": {
            "x": 790,
            "y": 110
          }
        },
        {
          "id": "fresh",
          "type": "logic.once",
          "params": {
            "key": "{{ $json.id }}"
          },
          "position": {
            "x": 40,
            "y": 330
          }
        },
        {
          "id": "draft",
          "type": "anthropic.ask",
          "params": {
            "credential": "my_claude",
            "prompt": "Write one post for X about this headline. Under 240 characters, no hashtags, no emoji, say what happened and why it matters.\n\n{{ $json.title }}",
            "model": "claude-sonnet-5",
            "system": "You write for a crypto audience that dislikes hype.",
            "maxTokens": 300
          },
          "position": {
            "x": 290,
            "y": 330
          }
        },
        {
          "id": "post",
          "type": "x.post",
          "params": {
            "credential": "my_x",
            "text": "{{ $json.text }}"
          },
          "position": {
            "x": 540,
            "y": 330
          }
        }
      ],
      "edges": [
        {
          "from": "clock",
          "fromPort": "main",
          "to": "news",
          "toPort": "main"
        },
        {
          "from": "news",
          "fromPort": "main",
          "to": "each",
          "toPort": "main"
        },
        {
          "from": "each",
          "fromPort": "main",
          "to": "about",
          "toPort": "main"
        },
        {
          "from": "about",
          "fromPort": "main",
          "to": "fresh",
          "toPort": "main"
        },
        {
          "from": "fresh",
          "fromPort": "main",
          "to": "draft",
          "toPort": "main"
        },
        {
          "from": "draft",
          "fromPort": "main",
          "to": "post",
          "toPort": "main"
        }
      ]
    }
  },
  {
    "slug": "contract-numbers-by-email",
    "title": "contract numbers by email",
    "summary": "Reads a number straight off a contract every morning and emails it to you. This one reads how much USDC exists; change the address and the function line to read anything else. Needs a Resend key named my_resend.",
    "package": {
      "name": "contract numbers by email",
      "nodes": [
        {
          "id": "clock",
          "type": "core.schedule",
          "params": {
            "mode": "every",
            "every": 1,
            "unit": "days"
          },
          "position": {
            "x": 40,
            "y": 150
          }
        },
        {
          "id": "read",
          "type": "web3.read",
          "params": {
            "chain": "ethereum",
            "address": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
            "signature": "function totalSupply() view returns (uint256)",
            "args": [],
            "rpc": ""
          },
          "position": {
            "x": 300,
            "y": 150
          }
        },
        {
          "id": "mail",
          "type": "resend.send",
          "params": {
            "credential": "my_resend",
            "to": "you@example.com",
            "subject": "USDC supply today",
            "html": "<p>{{ $json.result }}</p>",
            "from": ""
          },
          "position": {
            "x": 560,
            "y": 150
          }
        }
      ],
      "edges": [
        {
          "from": "clock",
          "fromPort": "main",
          "to": "read",
          "toPort": "main"
        },
        {
          "from": "read",
          "fromPort": "main",
          "to": "mail",
          "toPort": "main"
        }
      ]
    }
  },
